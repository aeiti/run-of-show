# Copy to backend/.env. Defaults match docker-compose.yml.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
POSTGRES_HOST=localhost
POSTGRES_DB=runofshow
POSTGRES_USER=runofshow
POSTGRES_PASSWORD=runofshow
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Password reset links point at the frontend. Emails print to the console
# unless EMAIL_BACKEND is set (e.g. django.core.mail.backends.smtp.EmailBackend
# with EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD, EMAIL_USE_TLS=1).
FRONTEND_URL=http://localhost:5173
# Uploaded scripts, showfiles and logos are stored under MEDIA_ROOT (default
# backend/media) and only served through the API, which checks the user's role.
# Set AWS_STORAGE_BUCKET_NAME to store them in S3 instead, or in any
# S3-compatible service with AWS_S3_ENDPOINT_URL. The keys can also come from
# the usual AWS environment variables or an instance role.
# MEDIA_ROOT=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Upload limits in megabytes.
# PRODUCTION_FILE_MAX_MB=50
# PRODUCTION_LOGO_MAX_MB=2
