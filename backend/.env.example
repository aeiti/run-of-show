# Copy to backend/.env. Defaults match docker-compose.yml.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
POSTGRES_HOST=localhost
POSTGRES_DB=runofshow
POSTGRES_USER=runofshow
POSTGRES_PASSWORD=runofshow
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Password reset links point at the frontend. Emails print to the console
# unless EMAIL_BACKEND is set (e.g. django.core.mail.backends.smtp.EmailBackend
# with EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD, EMAIL_USE_TLS=1).
FRONTEND_URL=http://localhost:5173
